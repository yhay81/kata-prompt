{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kata-prompt",
  "main": "src/worker.tsx",
  "compatibility_date": "2026-07-26",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/privacy", "/api/*", "/healthz"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kata-prompt",
      "database_id": "5e12edec-0735-47a5-bc46-f02f11f09f3b",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "WRITE_LIMITER",
      "namespace_id": "92072610",
      "simple": {
        "limit": 30,
        "period": 60,
      },
    },
  ],
  "triggers": {
    "crons": ["23 3 * * *"],
  },
}
